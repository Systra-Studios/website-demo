---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import { datum, t, type Sprache } from '../i18n/ui';
import { link, linkZu, seitenPfad, spracheVon, sprachversionen } from '../lib/links';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  const news = await getCollection('news');
  return [
    ...seiten.map((eintrag) => ({
      params: { pfad: seitenPfad(spracheVon(eintrag), eintrag.data.pfad) || undefined },
      props: { eintrag },
    })),
    ...news.map((eintrag) => ({
      params: { pfad: seitenPfad(spracheVon(eintrag), `news/${eintrag.data.pfad}`) },
      props: { eintrag },
    })),
  ];
}

interface Props {
  eintrag: CollectionEntry<'seiten'> | CollectionEntry<'news'>;
}

const { eintrag } = Astro.props;
const sprache: Sprache = spracheVon(eintrag);
const { Content } = await render(eintrag);
const versionen = await sprachversionen(eintrag);
const aktuellerLink = linkZu(eintrag);

const istSeite = eintrag.collection === 'seiten';
const seite = istSeite ? (eintrag as CollectionEntry<'seiten'>).data : null;
const artikel = !istSeite ? (eintrag as CollectionEntry<'news'>).data : null;

const neuigkeiten = seite?.news_anzeigen
  ? (await getCollection('news'))
      .filter((n) => spracheVon(n) === sprache)
      .sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime())
      .slice(0, 3)
  : [];

const buttonZiel = seite?.button_ziel ? link(seitenPfad(sprache, seite.button_ziel)) : null;
---

<Basis sprache={sprache} titel={eintrag.data.titel} beschreibung={eintrag.data.beschreibung} versionen={versionen} aktuellerLink={aktuellerLink}>
  {seite && (
    <>
      <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-24 pb-14">
        {seite.kicker && (
          <p class="inline-block bg-akzent-hell text-akzent text-[0.8rem] font-semibold tracking-wide uppercase px-3 py-1 rounded-full mb-6">
            {seite.kicker}
          </p>
        )}
        <h1 class="text-[2.4rem] sm:text-[3.6rem] leading-[1.05] font-bold tracking-tight max-w-3xl">{seite.headline}</h1>
        <p class="mt-6 text-lg sm:text-xl text-grau max-w-2xl leading-relaxed">{seite.intro}</p>
        {seite.button_text && buttonZiel && (
          <a href={buttonZiel} class="mt-9 inline-flex items-center gap-2 bg-tinte text-white px-6 py-3 rounded-full font-medium hover:bg-akzent transition-colors">
            {seite.button_text}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </section>

      {seite.vorteile && seite.vorteile.length > 0 && (
        <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-6">
          <ul class:list={['grid gap-4 sm:grid-cols-2', seite.vorteile.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {seite.vorteile.map((v) => (
              <li class="bg-flaeche rounded-2xl p-6">
                <h2 class="font-semibold text-lg">{v.titel}</h2>
                <p class="mt-2 text-grau leading-relaxed">{v.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="inhalt max-w-2xl">
          <Content />
        </div>
      </section>

      {neuigkeiten.length > 0 && (
        <section class="mx-auto max-w-6xl px-5 sm:px-8 mt-20">
          <h2 class="text-2xl font-bold tracking-tight mb-6">{t(sprache, 'news.titel')}</h2>
          <ul class="grid gap-4 sm:grid-cols-3">
            {neuigkeiten.map((n) => (
              <li>
                <a href={linkZu(n)} class="block h-full bg-flaeche rounded-2xl p-6 hover:bg-akzent-hell transition-colors">
                  <p class="text-sm text-grau">{datum(sprache, n.data.datum)}</p>
                  <h3 class="mt-2 font-semibold text-lg leading-snug">{n.data.titel}</h3>
                  <p class="mt-4 text-akzent text-sm font-medium">{t(sprache, 'news.mehr')} →</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}

  {artikel && (
    <article class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-20">
      <p class="text-sm text-grau">{datum(sprache, artikel.datum)}</p>
      <h1 class="mt-3 text-[2.1rem] sm:text-[2.9rem] leading-[1.1] font-bold tracking-tight max-w-3xl">{artikel.titel}</h1>
      <p class="mt-5 text-lg text-grau max-w-2xl leading-relaxed">{artikel.beschreibung}</p>
      <div class="inhalt max-w-2xl mt-10">
        <Content />
      </div>
      <a href={link(sprache === 'de' ? '' : sprache)} class="inline-block mt-10 text-akzent font-medium">← {t(sprache, 'news.zurueck')}</a>
    </article>
  )}
</Basis>
